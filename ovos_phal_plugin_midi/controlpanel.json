{
 "controlpanel": 1,
 "id": "midi",
 "title": "midi.title",
 "group": "music",
 "groups": [
  {
   "id": "music",
   "title": {
    "key": "nav.group.music",
    "label": "Music"
   },
   "order": 6,
   "level": "everyday"
  }
 ],
 "order": 90,
 "icon": "controlpanel.svg",
 "bus": "ovos.midi.",
 "blocks": [
  {
   "type": "text",
   "text": "midi.intro"
  },
  {
   "type": "status",
   "title": "midi.now.title",
   "query": "ovos.midi.status",
   "refresh": 10,
   "rows": [
    {
     "label": "midi.plays",
     "value": "{engine@midi.engine}"
    },
    {
     "label": "midi.soundfont.used",
     "value": "{soundfont}",
     "when": "soundfont"
    },
    {
     "label": "midi.port.used",
     "value": "{port}",
     "when": "port"
    },
    {
     "label": "midi.sound",
     "value": "{output}",
     "when": "output"
    },
    {
     "label": "midi.delay",
     "value": "{latency_ms} ms",
     "when": "latency_ms"
    },
    {
     "label": "midi.keyboards",
     "value": "{listening}",
     "empty": "midi.none"
    },
    {
     "label": "midi.instruments",
     "value": "{ports.outputs}",
     "empty": "midi.none"
    },
    {
     "label": "midi.problem",
     "value": "{error}",
     "when": "error"
    },
    {
     "label": "midi.problem",
     "text": "midi.noFluid",
     "when": "!have_fluidsynth"
    },
    {
     "label": "midi.problem",
     "text": "midi.noPorts",
     "when": "!ports.available"
    }
   ],
   "actions": [
    {
     "label": "midi.test.chord",
     "send": "ovos.midi.events",
     "privileged": false,
     "data": {
      "source": "control-panel",
      "events": [
       [
        "program",
        0,
        0,
        0
       ],
       [
        "note",
        0.02,
        0,
        60,
        90,
        1.6
       ],
       [
        "note",
        0.14,
        0,
        64,
        90,
        1.6
       ],
       [
        "note",
        0.26,
        0,
        67,
        90,
        1.6
       ],
       [
        "note",
        0.38,
        0,
        72,
        90,
        1.6
       ]
      ]
     }
    },
    {
     "label": "midi.test.drums",
     "send": "ovos.midi.events",
     "privileged": false,
     "data": {
      "source": "control-panel",
      "events": [
       [
        "note",
        0.0,
        9,
        36,
        100,
        0.2
       ],
       [
        "note",
        0.25,
        9,
        42,
        100,
        0.2
       ],
       [
        "note",
        0.5,
        9,
        38,
        100,
        0.2
       ],
       [
        "note",
        0.75,
        9,
        42,
        100,
        0.2
       ],
       [
        "note",
        1.0,
        9,
        36,
        100,
        0.2
       ],
       [
        "note",
        1.25,
        9,
        36,
        100,
        0.2
       ],
       [
        "note",
        1.5,
        9,
        38,
        100,
        0.2
       ],
       [
        "note",
        1.75,
        9,
        49,
        100,
        0.2
       ]
      ]
     }
    },
    {
     "label": "midi.test.stop",
     "send": "ovos.midi.panic",
     "privileged": false
    }
   ]
  },
  {
   "type": "form",
   "title": "midi.settings.title",
   "save": {
    "config": "PHAL.ovos-phal-plugin-midi",
    "reload": "ovos.midi.reload"
   },
   "fields": [
    {
     "name": "synth",
     "label": "midi.synth",
     "type": "select",
     "default": "auto",
     "options": [
      {
       "value": "auto",
       "label": "midi.synth.auto"
      },
      {
       "value": "builtin",
       "label": "midi.synth.builtin"
      },
      {
       "value": "fluidsynth",
       "label": "midi.synth.fluidsynth"
      },
      {
       "value": "port",
       "label": "midi.synth.port"
      }
     ]
    },
    {
     "name": "output_port",
     "label": "midi.port",
     "type": "select",
     "default": "",
     "show_when": {
      "synth": "port"
     },
     "options": [
      {
       "value": "",
       "label": "midi.portNone"
      }
     ],
     "options_from": {
      "query": "ovos.midi.status",
      "items": "ports.outputs"
     }
    },
    {
     "name": "soundfont",
     "label": "midi.soundfont",
     "type": "text",
     "default": "",
     "max_length": 500,
     "show_when": {
      "synth": "fluidsynth"
     }
    },
    {
     "name": "inputs",
     "label": "midi.listen",
     "type": "checkbox",
     "on": [
      "*"
     ],
     "off": [],
     "default": [
      "*"
     ]
    },
    {
     "name": "thru",
     "label": "midi.thru",
     "type": "checkbox",
     "default": false
    },
    {
     "name": "duck",
     "label": "midi.duck",
     "type": "checkbox",
     "default": true
    },
    {
     "name": "duck_volume",
     "label": "midi.duckVolume",
     "type": "slider",
     "min": 0,
     "max": 1,
     "step": 0.05,
     "default": 0.3
    },
    {
     "name": "reverb",
     "label": "midi.reverb",
     "type": "checkbox",
     "default": true
    },
    {
     "name": "audio",
     "label": "midi.audio",
     "type": "select",
     "default": "auto",
     "options": [
      {
       "value": "auto",
       "label": "midi.audio.auto"
      },
      {
       "value": "sounddevice",
       "label": "midi.audio.sounddevice"
      },
      {
       "value": "paplay",
       "label": "midi.audio.paplay"
      },
      {
       "value": "pw-cat",
       "label": "midi.audio.pwcat"
      },
      {
       "value": "aplay",
       "label": "midi.audio.aplay"
      }
     ]
    }
   ]
  }
 ]
}
